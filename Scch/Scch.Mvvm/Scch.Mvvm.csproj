<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GeneralAssemblyInfo.cs" Link="GeneralAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files that were never part of this project; kept on disk but excluded from the build. -->
    <Compile Remove="Converter\BackgroundConverter.cs" />
    <Compile Remove="Converter\VisibilityToBoolConverter.cs" />
    <Compile Remove="View\IWorkspaceView.cs" />
    <Compile Remove="ViewModel\MasterDetailViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scch.Common\Scch.Common.csproj" />
    <ProjectReference Include="..\Scch.Logging\Scch.Logging.csproj" />
  </ItemGroup>

</Project>

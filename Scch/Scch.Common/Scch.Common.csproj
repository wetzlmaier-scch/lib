<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GeneralAssemblyInfo.cs" Link="GeneralAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files that were never part of this project; kept on disk but excluded from the build. -->
    <Compile Remove="Collections\Generic\EnumerableExtensions.cs" />
    <Compile Remove="Collections\Generic\IListExtensions.cs" />
    <Compile Remove="ComponentModel\SortDescriptionComparer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

</Project>
